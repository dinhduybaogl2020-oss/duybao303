.bubble-layer {
  position: fixed;
  z-index: 1;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.bubble {
  --bubble-size: 54px;
  position: absolute;
  bottom: -100px;
  left: 8%;
  width: var(--bubble-size);
  height: var(--bubble-size);
  border: 1px solid rgba(103, 184, 224, 0.65);
  border-radius: 50%;
  background:
    radial-gradient(ellipse at 31% 23%, rgba(255, 255, 255, 0.98) 0 3%, transparent 14%),
    radial-gradient(ellipse at 38% 32%, rgba(255, 255, 255, 0.86) 0 7%, transparent 25%),
    radial-gradient(ellipse at 71% 73%, transparent 43%, rgba(76, 174, 223, 0.28) 58%, transparent 68%),
    radial-gradient(ellipse at 67% 23%, rgba(158, 183, 250, 0.32), transparent 48%),
    radial-gradient(ellipse at 32% 69%, rgba(92, 221, 223, 0.3), transparent 39%),
    rgba(219, 244, 255, 0.14);
  box-shadow:
    inset 4px 4px 10px rgba(255, 255, 255, 0.88),
    inset -5px -5px 12px rgba(50, 146, 221, 0.36),
    inset 1px -2px 5px rgba(42, 206, 216, 0.3),
    0 0 13px rgba(80, 170, 220, 0.13);
  opacity: 0;
  animation: bubble-rise var(--bubble-duration, 16s) var(--bubble-delay, 0s) infinite both;
  will-change: transform, opacity;
}

.bubble::before,
.bubble::after {
  position: absolute;
  display: block;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  content: "";
}

.bubble::before {
  top: 17%;
  right: 24%;
  width: 16%;
  height: 11%;
  transform: rotate(36deg);
}

.bubble::after {
  right: 16%;
  bottom: 25%;
  width: 24%;
  height: 5%;
  transform: rotate(-51deg);
}

.bubble-large {
  --bubble-size: 76px;
  --bubble-duration: 19s;
  left: 13%;
}

.bubble-medium {
  --bubble-size: 48px;
  --bubble-duration: 16s;
  --bubble-delay: -8s;
  left: 37%;
}

.bubble-small {
  --bubble-size: 30px;
  --bubble-duration: 13s;
  --bubble-delay: -4s;
  left: 61%;
}

.bubble-tiny {
  --bubble-size: 19px;
  --bubble-duration: 17s;
  --bubble-delay: -11s;
  left: 83%;
}

.bubble-last {
  --bubble-size: 36px;
  --bubble-duration: 21s;
  --bubble-delay: -14s;
  left: 94%;
}

.jellyfish {
  --jellyfish-duration: 27s;
  position: absolute;
  bottom: -125px;
  left: 25%;
  width: 82px;
  height: 104px;
  opacity: 0;
  animation: jellyfish-rise var(--jellyfish-duration) var(--jellyfish-delay, -6s) infinite both;
  filter: drop-shadow(0 5px 10px rgba(39, 135, 190, 0.17));
  will-change: transform, opacity;
}

.jellyfish-bell {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 4px;
  width: 74px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-bottom: 2px solid rgba(72, 171, 218, 0.75);
  border-radius: 48% 48% 42% 42%;
  background:
    radial-gradient(ellipse at 32% 23%, rgba(255, 255, 255, 0.98), transparent 28%),
    radial-gradient(ellipse at 62% 71%, rgba(148, 213, 255, 0.8), transparent 52%),
    linear-gradient(140deg, rgba(217, 246, 255, 0.82), rgba(76, 170, 225, 0.65));
  box-shadow:
    inset 0 4px 9px rgba(255, 255, 255, 0.75),
    inset 0 -5px 9px rgba(58, 135, 210, 0.4),
    0 0 14px rgba(109, 204, 239, 0.35);
  animation: jellyfish-pulse 1.8s ease-in-out infinite;
}

.jellyfish-tentacle {
  position: absolute;
  top: 36px;
  width: 2px;
  height: 57px;
  border-radius: 50%;
  background: linear-gradient(
    to bottom,
    rgba(111, 190, 233, 0.76),
    rgba(131, 203, 231, 0.12)
  );
  transform-origin: top center;
}

.jellyfish-tentacle:nth-child(2) {
  left: 23px;
  animation: tentacle-sway 2.4s ease-in-out infinite alternate;
}

.jellyfish-tentacle:nth-child(3) {
  left: 37px;
  height: 66px;
  animation: tentacle-sway 2.1s ease-in-out -0.6s infinite alternate-reverse;
}

.jellyfish-tentacle:nth-child(4) {
  left: 51px;
  height: 59px;
  animation: tentacle-sway 2.6s ease-in-out -0.3s infinite alternate;
}

.jellyfish-tentacle:nth-child(5) {
  left: 63px;
  height: 48px;
  animation: tentacle-sway 2.2s ease-in-out -0.9s infinite alternate-reverse;
}

.jellyfish-two {
  --jellyfish-duration: 31s;
  --jellyfish-delay: -19s;
  left: 73%;
  transform: scale(0.72);
}

@keyframes jellyfish-rise {
  0% {
    opacity: 0;
    transform: translate3d(-12px, 0, 0);
  }

  12%,
  80% {
    opacity: 0.72;
  }

  100% {
    opacity: 0;
    transform: translate3d(30px, -125vh, 0);
  }
}

@keyframes jellyfish-pulse {
  0%,
  100% {
    transform: scaleY(1);
  }

  45% {
    transform: scaleY(0.82);
  }
}

@keyframes tentacle-sway {
  from {
    transform: rotate(-8deg);
  }

  to {
    transform: rotate(9deg);
  }
}

@keyframes bubble-rise {
  0% {
    opacity: 0;
    transform: translate3d(0, 0, 0);
  }

  12% {
    opacity: 0.62;
  }

  72% {
    opacity: 0.5;
  }

  100% {
    opacity: 0;
    transform: translate3d(32px, -125vh, 0);
  }
}

