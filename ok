  .menu-toggle {
    z-index: 2;
    display: flex;
    width: 42px;
    height: 42px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: transparent;
    cursor: pointer;
  }

  .menu-toggle > span {
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink);
    transition:
      transform 180ms ease,
      translate 180ms ease;
  }

  .menu-toggle[aria-expanded="true"] > span:first-child {
    translate: 0 3px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] > span:last-child {
    translate: 0 -3px;
    transform: rotate(-45deg);
  }

  .navigation {
    position: absolute;
    top: 68px;
    right: 0;
    left: 0;
    display: none;
    align-items: stretch;
    gap: 0;
    padding: 7px 20px 18px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .navigation.is-open {
    display: flex;
    flex-direction: column;
  }

  .navigation > a {
    padding: 13px 4px;
    border-bottom: 1px solid #e7ebf0;
  }

  .navigation .nav-contact {
    justify-content: space-between;
    margin-top: 10px;
    padding: 12px;
    border: 1px solid var(--line);
  }

  .hero {
    min-height: 0;
    padding-block: 64px 75px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    gap: 31px;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    margin-bottom: 17px;
    font-size: 8px;
  }

  h1 {
    font-size: clamp(57px, 13vw, 76px);
  }

  .hero-role {
    font-size: 12px;
  }

  .hero-intro {
    max-width: 430px;
    font-size: 12px;
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 15px;
  }

  .button {
    min-height: 46px;
    font-size: 10px;
  }

  .hero-meta {
    margin-top: 25px;
    font-size: 9px;
  }

  .hero-art {
    min-height: 374px;
    margin-top: 7px;
  }

  .profile-card {
    width: min(290px, 73%);
    height: 340px;
  }

  .avatar {
    width: 176px;
    height: 230px;
  }

  .avatar-outline {
    width: 143px;
    height: 143px;
  }

  .avatar-initials {
    font-size: 62px;
  }

  .orbit-one {
    width: min(370px, 95vw);
    height: min(370px, 95vw);
  }

  .orbit-two {
    width: min(420px, 106vw);
    height: 295px;
  }

  .note-study {
    top: 35px;
    left: 0;
  }

  .note-focus {
    right: -1px;
    bottom: 34px;
  }

  .scroll-cue {
    display: none;
  }

  .intro-grid,
  .skills-grid,
  .contact-inner {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .section-heading h2 {
    font-size: 36px;
  }

  .intro-content {
    padding-top: 0;
  }

  .intro-lead {
    font-size: 16px;
  }

  .body-copy {
    font-size: 12px;
  }

  .education-card {
    gap: 12px;
    padding: 14px;
  }

  .section-heading-row {
    display: block;
    margin-bottom: 30px;
  }

  .section-heading-row h2 {
    max-width: 400px;
  }

  .section-heading-row .eyebrow {
    max-width: 320px;
    line-height: 1.6;
  }

  .heading-note {
    max-width: 370px;
    margin-top: 15px;
  }

  .experience-card {
    grid-template-columns: 1fr 24px;
    gap: 14px 10px;
    padding-block: 25px;
  }

  .experience-date {
    grid-column: 1 / -1;
    align-items: center;
    gap: 10px;
    padding: 0;
  }

  .experience-detail {
    grid-column: 1;
  }

  .experience-number {
    grid-column: 2;
    grid-row: 2;
    padding-top: 5px;
  }

  .experience-detail h3 {
    font-size: 18px;
