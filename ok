    justify-content: space-between;
    padding-block: 19px;
  }

  .footer-inner > p {
    order: 3;
    width: 100%;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .bubble {
    animation: none;
    opacity: 0;
  }

  .jellyfish {
    animation: none;
    opacity: 0;
  }

  .motion-enabled .section > .container {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* Improve contrast and readability on the blue CV theme. */
body {
  color: #102d49;
}

.navigation {
  font-size: 13px;
}

.navigation a:hover,
.text-link:hover,
.back-top:hover {
